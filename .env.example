APP_NAME=Supplement Advisor
APP_VERSION=1.0.0
DEBUG=False
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mysupplements_db
LLM_API_KEY=
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
MIN_DISPLAY_SCORE=4
# False = fast deterministic explanation (default). True = LLM writes it (slower).
USE_LLM_EXPLANATION=False
# veto = a triggered hard contraindication removes the supplement before ranking
# (default). soft = the old behaviour, where the penalty is subtracted from the
# score and can be outweighed by positive matches. Keep "soft" available: the
# comparison between the two is what table 8.6 reports.
SAFETY_MODE=veto
